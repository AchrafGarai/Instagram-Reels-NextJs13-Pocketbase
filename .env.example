# URL the Next.js server uses to reach PocketBase.
POCKETBASE_URL=http://127.0.0.1:8090
# URL the browser uses to load media (videos, avatars) from PocketBase.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Force the read-only demo with static sample reels (also used automatically
# when PocketBase is unreachable).
# DEMO_MODE=true
